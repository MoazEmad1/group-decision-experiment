# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=experiment
POSTGRES_PASSWORD=experiment
POSTGRES_DB=experiment

# Experiment condition. Path is relative to the backend container's /app,
# where config.yml and configs/ are mounted. Default: config.yml (1_human_2_ai).
# CONFIG_PATH=configs/3_humans.yml
# CONFIG_PATH=configs/2_humans_1_ai.yml
# CONFIG_PATH=configs/1_human_2_ai.yml
# CONFIG_PATH=configs/1_human_2_ai_llm.yml   # AI messages written by Claude (needs the key below)

# Only used when ai.mode is llm. Leave empty to use the rule-based AI.
ANTHROPIC_API_KEY=
